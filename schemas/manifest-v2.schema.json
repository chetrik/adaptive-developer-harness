{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "copyright": {
            "type": "string",
            "minLength": 1
          },
          "source_repository": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "license",
          "copyright",
          "source_repository",
          "source_file",
          "source_fingerprint",
          "scope"
        ]
      }
    },
    "application_tests": {
      "type": "string",
      "minLength": 1
    },
    "native_discovery": {
      "type": "string",
      "minLength": 1
    },
    "managed_block_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pending_removal": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "generator",
        "policy",
        "catalog",
        "adapter",
        "adapter_version"
      ]
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "active",
              "pending_removal"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "revision",
          "status",
          "files"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "modules",
    "files",
    "provenance",
    "application_tests",
    "native_discovery",
    "managed_block_sha256",
    "pending_removal",
    "versions",
    "owners",
    "components"
  ]
}
