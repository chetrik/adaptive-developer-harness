{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "phase": {
      "enum": [
        "Specification",
        "Implementation",
        "Verification"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "completed": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "unfinished": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true,
      "maxItems": 200
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not-verified",
              "skipped"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "command",
          "status",
          "exit_code",
          "detail"
        ]
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "next_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "session_id",
    "phase",
    "task",
    "decisions",
    "completed",
    "unfinished",
    "changed_files",
    "tests",
    "risks",
    "next_step"
  ]
}
