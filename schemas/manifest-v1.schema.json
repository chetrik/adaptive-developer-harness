{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "copyright": {
            "type": "string",
            "minLength": 1
          },
          "source_repository": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "license",
          "copyright",
          "source_repository",
          "source_file",
          "source_fingerprint",
          "scope"
        ]
      }
    },
    "application_tests": {
      "type": "string",
      "minLength": 1
    },
    "native_discovery": {
      "type": "string",
      "minLength": 1
    },
    "managed_block_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pending_removal": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "modules",
    "files",
    "provenance",
    "application_tests",
    "native_discovery"
  ]
}
