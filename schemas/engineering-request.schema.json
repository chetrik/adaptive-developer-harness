{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "feature",
            "bugfix"
          ]
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "acceptance": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "given": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "when": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "then": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "category": {
                    "enum": [
                      "behavior",
                      "error",
                      "security",
                      "migration",
                      "api"
                    ]
                  }
                },
                "required": [
                  "id",
                  "given",
                  "when",
                  "then",
                  "category"
                ]
              }
            },
            "edge_cases": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "nfr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "enum": [
                    "required",
                    "none",
                    "unknown"
                  ]
                },
                "criteria": {
                  "type": "array",
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "applicability",
                "criteria",
                "reason"
              ]
            },
            "questions": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "critical": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "text",
                  "critical"
                ]
              }
            },
            "source": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "goal",
            "scope",
            "acceptance",
            "edge_cases",
            "nfr",
            "questions",
            "source"
          ]
        },
        "context": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "category": {
                "enum": [
                  "specification",
                  "architecture",
                  "code",
                  "rules",
                  "handoff"
                ]
              },
              "critical": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "sha256",
              "start",
              "end",
              "category",
              "critical"
            ]
          }
        },
        "code_paths": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "test_paths": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "config_paths": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ac_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "test_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "ac_id",
              "test_id"
            ]
          }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "applicability": {
              "enum": [
                "required",
                "none",
                "unknown"
              ]
            },
            "paths": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "applicability",
            "paths",
            "reason"
          ]
        },
        "handoff_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "spec",
        "context",
        "code_paths",
        "test_paths",
        "config_paths",
        "checks",
        "documentation",
        "handoff_id"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_approval": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxItems": 32
        },
        "red": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "green": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "enum": [
        "implementation",
        "verification",
        "complete"
      ]
    }
  },
  "required": [
    "task",
    "receipts",
    "state_dir",
    "transition"
  ]
}
