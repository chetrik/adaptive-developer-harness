{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adaptive-developer-harness/harness-plan.schema.json",
  "title": "Harness Plan — exchange format (draft)",
  "description": "Schema validates plan shape, not permissions or security. The engine must enforce approval before side effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "assessment",
    "host",
    "policy_version",
    "catalog_version",
    "module_decisions",
    "proposed_operations",
    "approval",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready-for-approval",
        "approved",
        "applied",
        "verified",
        "needs-review",
        "failed"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "project_type",
        "development_stage",
        "user_mode",
        "risk_flags",
        "unknowns"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_type": {
          "type": "string",
          "minLength": 1
        },
        "development_stage": {
          "type": "string",
          "enum": [
            "greenfield",
            "brownfield",
            "unknown"
          ]
        },
        "user_mode": {
          "type": "string",
          "enum": [
            "beginner",
            "developer"
          ]
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature_scale": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "XS",
            "S",
            "M",
            "L",
            "XL",
            null
          ]
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "capabilities_verified",
        "supports_subagents",
        "supports_hooks",
        "network_access"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities_verified": {
          "type": "boolean"
        },
        "supports_subagents": {
          "type": "boolean"
        },
        "supports_hooks": {
          "type": "boolean"
        },
        "network_access": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "reuse_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision",
        "candidates"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-required",
            "not-run",
            "unverified",
            "verified"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "undecided",
            "adapt",
            "compose",
            "build",
            "buy",
            "not-applicable"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "verification_status",
              "license_status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "verification_status": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified"
                ]
              },
              "license_status": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified",
                  "restricted",
                  "unknown"
                ]
              },
              "source_revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "module_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "reason",
          "evidence",
          "trigger"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "selected",
              "skipped",
              "blocked-by-host",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "additional_cost": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "proposed_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "target_path",
          "reason"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "preserve",
              "skip",
              "remove-proposal"
            ]
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "diff_preview": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-run",
            "pass",
            "needs-review",
            "fail"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
